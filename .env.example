# ==============================================================================
# .env.example — salin jadi `.env` lalu isi. JANGAN pernah commit file .env.
# ==============================================================================

# --- Supabase (wajib) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# --- Google Gemini (wajib) ---
# Boleh satu key yang sama untuk keduanya, atau dua key berbeda untuk kuota ganda.
GEMINI_EMBEDDING_API_KEY=your-gemini-key
GEMINI_REASONING_API_KEY=your-gemini-key
# Opsional — override nama model (default di ai_engine.py):
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# GEMINI_REASONING_MODEL=gemini-3.5-flash-lite

# --- Telegram (wajib untuk notifikasi) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- RapidAPI / JSearch (opsional — semua sumber lain tanpa key) ---
RAPIDAPI_KEY=your-rapidapi-key

# --- Tuning (opsional — default sudah disetel di kode) ---
# SIMILARITY_THRESHOLD=0.52      # gerbang vector similarity (v3: 0.58 -> 0.52)
# MIN_NOTIFY_SCORE=50            # skor minimum untuk masuk Telegram
# MAX_JOBS_TO_NOTIFY=15          # maksimum lowongan per kiriman
# MAX_JOBS_TO_EMBED=150          # batas embedding per run (kuota Gemini)
# MAX_JOBS_TO_REASON=80          # batas reasoning per run
# MAX_QUERIES_PER_TRACK=3        # query pencarian per bidang
# MAX_JOB_AGE_DAYS=21            # umur maksimum lowongan
# JOBS_RETENTION_DAYS=7          # retensi daily_jobs
# SEEN_RETENTION_DAYS=45         # memori dedup lintas-run
# DISABLED_SOURCES=remoteok      # sumber yang dilewati (pisahkan koma)
